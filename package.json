{
  "name": "termdeck",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "app": "vite build && electron .",
    "package": "vite build && electron-packager . TermDeck --platform=win32 --arch=x64 --out=release --overwrite --icon=build/icon.ico --prune=true --ignore=\"(^/src$|^/release$|tsconfig.*|vite.config.*|\\.zip$|\\.md$|^/build$|^/\\.env$|^/\\.github$|make-icon\\.ps1)\"",
    "package:mac": "vite build && electron-packager . TermDeck --platform=darwin --arch=universal --out=release --overwrite --icon=build/icon.icns --app-bundle-id=com.tatetime.termdeck --prune=true --ignore=\"(^/src$|^/release$|tsconfig.*|vite.config.*|\\.zip$|\\.md$|^/build$|^/\\.env$|^/\\.github$|make-icon\\.ps1)\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
